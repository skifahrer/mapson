{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/skifahrer/schemas/master/schema/v1/mapszip.schema.json",
  "title": "mapszip manifest",
  "description": "The JSON manifest at the head of a .mapszip: a mapsack, its maps and their data, in one file. README.md describes the container around it.",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" },
      "allOf": [
        { "contains": { "type": "object", "properties": { "path": { "const": "map.mapson" } }, "required": ["path"] } },
        { "contains": { "type": "object", "properties": { "path": { "const": "package.json" } }, "required": ["path"] } }
      ],
      "description": "In payload order: each entry's bytes follow the previous one's. The entries are a mapsack's files."
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["path", "size", "compressedSize", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/path",
          "description": "A path in the mapsack: `map.mapson`, `package.json`, a `.pmtiles` or `files/<file>`."
        },
        "size": { "type": "integer", "minimum": 0, "description": "Bytes once unpacked." },
        "compressedSize": { "type": "integer", "minimum": 0, "description": "Bytes in the payload." },
        "sha256": { "$ref": "#/$defs/sha256", "description": "Of the unpacked bytes." },
        "stored": {
          "type": "boolean",
          "description": "True: the bytes are stored as they are. Absent or false: LZFSE-compressed."
        }
      }
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$",
      "description": "Relative, `/`-separated, never `..`."
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
