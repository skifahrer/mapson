{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/skifahrer/schemas/master/schema/v1/servson.schema.json",
  "title": "servson v1",
  "description": "Saved map servers as JSON, a mapson extension: `required` keys must be present, others are optional, unknown ones ignored.",
  "type": "object",
  "required": ["exportedAt", "includesCredentials", "servers"],
  "properties": {
    "$schema": { "type": "string", "description": "The schema the file follows: this schema's $id." },
    "_schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Absent reads as 1. Readers refuse a version newer than theirs."
    },
    "exportedAt": { "$ref": "mapson.schema.json#/$defs/date", "description": "When the file was written." },
    "includesCredentials": {
      "type": "boolean",
      "description": "Whether the writer chose to carry header values and address keys. False means they were left out."
    },
    "servers": {
      "type": "array",
      "items": { "$ref": "#/$defs/server" },
      "description": "The servers, in the writer's order."
    },
    "rikiHeaders": {
      "type": "object",
      "additionalProperties": { "$ref": "mapson.schema.json#/$defs/stringMap" },
      "description": "Host → header name → value, for the servers' own hosts only. Absent unless `includesCredentials`."
    },
    "rikiServiceProxies": {
      "$ref": "mapson.schema.json#/$defs/stringMap",
      "description": "Host → proxy URL prefix the servers are asked through."
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "required": ["id", "name", "kind", "url", "headerNames", "symbol", "format", "maxZoom",
                   "attribution", "allowsOffline", "layers", "facts", "addedAt"],
      "properties": {
        "id": { "$ref": "mapson.schema.json#/$defs/uuid", "description": "Readers issue a fresh one on import." },
        "name": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["arcgis", "tilejson", "tiles", "mapproxy", "api"],
          "description": "Esri service or folder, TileJSON document, tile template, MapProxy, or JSON/XML API."
        },
        "url": { "type": "string", "description": "The service root, the TileJSON document, or the tile template." },
        "referrer": { "type": "string" },
        "headerNames": {
          "$ref": "mapson.schema.json#/$defs/stringList",
          "description": "Header names only; values travel in `rikiHeaders`."
        },
        "requestSetup": { "$ref": "mapson.schema.json#/$defs/requestSetup" },
        "symbol": { "type": "string", "description": "SF Symbol name." },
        "iconTintHex": { "type": "string", "description": "`#RRGGBB`." },
        "tileTemplate": { "type": "string", "description": "What a TileJSON document named, `{z}/{x}/{y}`." },
        "format": {
          "type": "string",
          "enum": ["raster", "vector", "wms", "arcgisImage", "arcgisQuery", "api"]
        },
        "minZoom": { "type": "integer", "minimum": 0 },
        "maxZoom": { "type": "integer", "minimum": 0 },
        "attribution": { "type": "string" },
        "credit": {
          "$ref": "mapson.schema.json#/$defs/credit",
          "description": "Written on every layer taken from the server."
        },
        "allowsOffline": { "type": "boolean", "description": "Whether its tiles may be stored for offline use." },
        "layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/serverLayer" },
          "description": "What it published when last read."
        },
        "publishedServices": {
          "type": "array",
          "items": { "$ref": "#/$defs/service" },
          "description": "An Esri directory's services and folders."
        },
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/fact" },
          "description": "What it said it can do, in its own words."
        },
        "readAt": { "$ref": "mapson.schema.json#/$defs/date", "description": "When it was last read." },
        "addedAt": { "$ref": "mapson.schema.json#/$defs/date" }
      }
    },

    "serverLayer": {
      "type": "object",
      "required": ["id", "name", "supportsQuery"],
      "properties": {
        "id": { "type": "string", "description": "The Esri layer's number, or the vector layer's own id." },
        "name": { "type": "string" },
        "number": { "type": "integer", "description": "Its number inside an Esri service." },
        "geometryType": { "type": "string" },
        "supportsQuery": { "type": "boolean" },
        "groupName": { "type": "string" },
        "summary": { "type": "string" },
        "template": { "type": "string", "description": "Its own address, where it has one." },
        "tileFormat": {
          "type": "string",
          "enum": ["raster", "vector", "wms", "arcgisImage", "arcgisQuery", "api"]
        },
        "minZoom": { "type": "integer", "minimum": 0 },
        "maxZoom": { "type": "integer", "minimum": 0 },
        "bounds": { "$ref": "mapson.schema.json#/$defs/geoBox" }
      }
    },

    "service": {
      "type": "object",
      "required": ["id", "name", "type", "isFolder", "isDrawn", "layers", "facts", "held", "summary"],
      "properties": {
        "id": { "type": "string", "description": "Its own endpoint." },
        "name": { "type": "string" },
        "type": { "type": "string", "description": "MapServer, FeatureServer, …; empty for a folder." },
        "isFolder": { "type": "boolean" },
        "isDrawn": { "type": "boolean", "description": "Whether Riki Maps draws this type." },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/serverLayer" } },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "held": {
          "type": "array",
          "items": { "$ref": "#/$defs/service" },
          "description": "What a folder holds, once it was opened."
        },
        "summary": { "type": "string" },
        "readAt": { "$ref": "mapson.schema.json#/$defs/date" },
        "failedAt": { "$ref": "mapson.schema.json#/$defs/date", "description": "When a read last got no answer." }
      }
    },

    "fact": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" }
      }
    }
  }
}
